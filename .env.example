# LOCAL Docker configuration. For Vite development use APP_ORIGIN=http://localhost:5173.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8080
# Use a different hostname, not merely a different port. Never host the app on 127.0.0.1.
PREVIEW_ORIGIN=http://127.0.0.1:8001
DATABASE_URL=sqlite:////data/studio.db
COOKIE_SECURE=false
# Generate independently with: python -m app.cli secrets (from backend).
SESSION_SECRET=local-only-change-this-secret-before-an-event-12345
PREVIEW_SECRET=local-preview-secret-change-before-an-event-12345
# Set an Argon2 hash, never a plaintext password. See README.
# Single quotes stop Docker Compose interpreting the dollar signs in the hash.
ADMIN_PASSWORD_HASH=''
SESSION_HOURS=6

# Mock is an explicit deterministic offline demo. Production rejects mock mode.
PRIMARY_AI_PROVIDER=mock
FALLBACK_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# USD per MILLION tokens for the exact configured model; must be set for paid providers.
# No prices/models are assumed. Check current provider pricing, including thinking tokens.
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
GEMINI_INPUT_PRICE=
GEMINI_OUTPUT_PRICE=
PROVIDER_TIMEOUT_SECONDS=90
SAFE_RETRIES=1
MAX_HTML_BYTES=180000
MAX_PROMPT_CHARS=3000
# Per resized style image; included within MAX_INPUT_TOKENS reservations. Rehearse your chosen model.
REFERENCE_IMAGE_TOKEN_RESERVE=6000
PREVIEW_TOKEN_SECONDS=900
# Optional private UI-managed AI settings. Preview never mounts this directory.
PROVIDER_CONFIG_PATH=./data-private/providers.json
